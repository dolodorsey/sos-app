{
  "name": "sos-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm audit --omit=dev --audit-level=critical",
    "start": "next start",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.112.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10",
    "brace-expansion": "5.0.8",
    "postcss": "8.5.18",
    "sharp": "0.35.0",
    "tar": "7.5.22",
    "ws": "8.21.1"
  }
}
